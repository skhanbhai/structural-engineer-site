# Files that must NEVER ship to the public asset bucket.
# Without this, Wrangler was uploading the entire .git/ directory,
# which exposed the repo's git history at /.git/HEAD etc.
.git
.git/**
.wrangler
.wrangler/**
.gitignore
.assetsignore
wrangler.jsonc
src
src/**
node_modules
node_modules/**
*.log
.DS_Store
# Internal working docs — never public
docs
docs/**
# Unused draft asset with fabricated job details — must not be served
assets/services/panoptic-beam-calculation-example.svg
# Source/working images (unoptimised PNG originals) - keep in the repo for
# provenance, never upload to the public asset bucket.
assets/services/extension/**

# Search Console exports — must never be served publicly
GSC Console
GSC Console/**
GSC data
GSC data/**

# AI-generated crack images (ChatGPT, C2PA-signed). Not used on the site: the
# crack guides illustrate the diagnostic patterns with hand-built SVG diagrams
# in assets/diagrams/ instead. Kept on disk only so the decision is traceable.
assets/services/further-crack-inspection
assets/services/further-crack-inspection/**
